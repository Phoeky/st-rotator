{
  "base_url": "https://token.sensenova.cn/v1",
  "default_model": "deepseek-v4-flash",

  "strategy": "round_robin",
  "max_attempts": 8,
  "timeout": 60,
  "connect_timeout": 10,
  "acquire_timeout": 120,
  "max_total_wait": 120,
  "acquire_fail_fast": 15,
  "backoff_mode": "exponential",
  "retry_backoff": 0.5,
  "max_retry_backoff": 8,
  "fixed_backoff": 1,

  "rate_control": {
    "mode": "fixed",
    "qps": 0.2,
    "min_qps": 0.15,
    "max_qps": 1.5,
    "decrease": 0.85,
    "increase_step": 0.05,
    "recovery_seconds": 8
  },
  "max_connections": 64,
  "max_keepalive": 16,

  "cooldown": {
    "base": 30,
    "factor": 2,
    "max": 90,
    "jitter": 0.5,
    "invalid_ttl": 600,
    "server_error": 2,
    "model_unavailable": 300
  },

  "flash_lite_exchange": {
    "enabled": false,
    "model": "sensenova-6.8-flash-lite",
    "concurrency": 2,
    "requests_per_trigger": 64,
    "min_interval_s": 300,
    "long_text_max_tokens": 1024,
    "image_enabled": true,
    "image_size": 768,
    "multi_image_count": 3,
    "max_workers": 8
  },

  "model_filter": {
    "available": ["deepseek-v4.1-flash"]
  },

  "accounts": [
    {
      "name": "账号1",
      "api_keys": ["${SENSENOVA_KEY_1}"],
      "rpm_limit": 2,
      "max_concurrency": 16,
      "weight": 1
    },
    {
      "name": "账号2",
      "api_keys": ["${SENSENOVA_KEY_2}"],
      "rpm_limit": 2,
      "max_concurrency": 16,
      "weight": 1
    },
    {
      "name": "账号3",
      "api_keys": ["${SENSENOVA_KEY_3}"],
      "rpm_limit": 2,
      "max_concurrency": 16,
      "weight": 1
    }
  ]
}
